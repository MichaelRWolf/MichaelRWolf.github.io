#! /bin/bash
set -euo pipefail

# Ruby comes from a prebuilt Homebrew bottle, ruby@<major.minor> from .ruby-version.
# To upgrade: brew install ruby@X.Y, then echo X.Y > .ruby-version
cd ~/repos/MichaelRWolf.github.io

ruby_version=$(cut -d. -f1-2 .ruby-version)
ruby_prefix=$(brew --prefix "ruby@${ruby_version}")
if [ ! -x "${ruby_prefix}/bin/ruby" ]; then
    echo "Ruby ${ruby_version} not installed. Run: brew install ruby@${ruby_version}" >&2
    exit 1
fi
export PATH="${ruby_prefix}/bin:${PATH}"

bundle install
rm -rf _site

set -xv
 # Optional: --livereload --drafts
bundle exec jekyll serve "$@" --livereload &

open http://localhost:4000
